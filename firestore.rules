rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read their own profile. All writes go through Cloud Functions (Admin SDK bypasses these rules).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Client side error logging (src/functions/registerError.ts)
    match /errors/{errorId} {
      allow create: if request.auth != null;
    }

    // Everything else (stations, API keys, ...) is only accessible from Cloud Functions
  }
}
